<%- include('partials/head', { title: 'Peminjaman Saya' }) %>
<%- include('partials/header') %>
<main id="konten" class="shell inner-main">
  <% if (overview) { %>
    <%- include('partials/member-overview') %>
  <% } else { %>
    <a class="back-link" href="/peminjaman"><%- icon('arrow-left', 17) %> Kembali ke dashboard anggota</a>
    <div class="page-heading">
      <div>
        <h1 data-word-reveal>Peminjaman saya</h1>
        <p><%= selectedStatus ? statuses[selectedStatus].label : 'Pantau pengajuan, pengambilan, dan pengembalian alatmu.' %></p>
      </div>
      <a class="button button-primary" href="/#katalog"><%- icon('plus', 18) %> Cari alat</a>
    </div>
  <% } %>
  <% if (overview) { %><div class="section-heading dashboard-section" id="daftar-pinjaman"><h2 data-word-reveal>Peminjaman saya</h2></div><% } %>
  <%- include('partials/feedback') %>
  <%- include('partials/loan-tabs', { base: '/peminjaman', counts: null }) %>
  <% if (!loans.length) { %>
    <%- include('partials/empty', {
      glyph: 'clipboard-list',
      title: filter === 'history' ? 'Belum ada riwayat' : 'Belum ada peminjaman',
      description: filter === 'history' ? 'Peminjaman yang selesai akan muncul di sini.' : 'Pilih alat yang kamu butuhkan dan ajukan peminjaman.',
      link: filter === 'history' ? null : { href: '/#katalog', label: 'Jelajahi katalog' },
    }) %>
  <% } else { %>
    <div class="loan-list">
      <% for (const loan of loans) { %>
        <article class="panel loan-card" id="pinjaman-<%= loan.id %>" tabindex="-1" data-reveal>
          <header class="loan-card-header">
            <div class="loan-item">
              <div class="loan-thumbnail">
                <%- include('partials/equipment-image', {
                  item: { name: loan.equipment_name, image: loan.image, category: loan.category },
                  eager: false,
                }) %>
              </div>
              <div>
                <span class="loan-reference">#<%= loan.id %> · <%= loan.group_id ? 'Proyek' : categoryById[loan.category].name %></span>
                <h2>
                  <% if (loan.group_id) { %>
                    <%= loan.title %>
                  <% } else if (loan.equipment_active) { %>
                    <a href="/alat/<%= loan.equipment_id %>"><%= loan.equipment_name %></a>
                  <% } else { %>
                    <%= loan.equipment_name %>
                  <% } %>
                </h2>
              </div>
            </div>
            <%- include('partials/loan-badge', { loan }) %>
          </header>
          <%- include('partials/loan-progress', { loan }) %>
          <%- include('partials/loan-meta', { loan }) %>
          <%- include('partials/loan-components', { loan }) %>
          <% if (loan.status === 'pending' || loan.status === 'approved') { %>
            <form class="loan-actions" action="/peminjaman/<%= loan.id %>/batal" method="post" data-busy-label="Memproses…">
              <%- include('partials/csrf') %>
              <button class="button button-small button-quiet-danger" type="submit" data-confirm="Batalkan peminjaman ini?">Batalkan pengajuan</button>
            </form>
          <% } else if (loan.status === 'returned') { %>
            <div class="loan-actions">
              <% if (loan.project_id) { %>
                <a class="button button-small button-secondary" href="/galeri/<%= loan.project_id %>"><%- icon('images', 16) %> Lihat rakitan</a>
              <% } else { %>
                <a class="button button-small button-secondary" href="/galeri/bagikan?pinjaman=<%= loan.id %>"><%- icon('camera', 16) %> Bagikan rakitan</a>
              <% } %>
            </div>
          <% } %>
        </article>
      <% } %>
    </div>
  <% } %>
</main>
<%- include('partials/footer') %>
