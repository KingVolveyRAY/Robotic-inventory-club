<details class="music-player" data-music-player>
  <summary class="music-toggle">
    <%- icon('headphones', 19) %>
    <span>Musik</span>
    <span class="music-signal" aria-hidden="true"><i></i><i></i><i></i></span>
  </summary>
  <section class="music-panel" aria-label="Pemutar musik RoboLab" data-lenis-prevent>
    <div class="music-track">
      <span class="music-art"><%- icon('audio-lines', 25) %></span>
      <div>
        <p>Instrumental RoboLab</p>
        <h2 data-music-title aria-live="polite">Sirkuit Senja</h2>
      </div>
    </div>
    <audio controls preload="none" src="/music/sirkuit-senja.mp3" data-music-audio></audio>
    <div class="music-controls" data-music-controls hidden>
      <div class="music-progress">
        <input type="range" min="0" max="62.6" step="0.1" value="0" aria-label="Posisi lagu" data-music-seek>
        <div class="music-times" aria-hidden="true">
          <span data-music-elapsed>0:00</span>
          <span data-music-duration>1:02</span>
        </div>
      </div>
      <div class="music-transport">
        <button type="button" class="music-control" aria-label="Lagu sebelumnya" data-music-previous><%- icon('skip-back', 19) %></button>
        <button type="button" class="music-control music-play" aria-label="Putar musik" data-music-play>
          <span data-music-play-icon><%- icon('play', 21) %></span>
          <span data-music-pause-icon hidden><%- icon('pause', 21) %></span>
        </button>
        <button type="button" class="music-control" aria-label="Lagu berikutnya" data-music-next><%- icon('skip-forward', 19) %></button>
      </div>
      <div class="music-settings">
        <label class="field music-library">
          <span>Daftar lagu</span>
          <select data-music-library>
            <option value="/music/sirkuit-senja.mp3" data-duration="62.6">Sirkuit Senja</option>
            <option value="/music/orbit-pelan.mp3" data-duration="68.6">Orbit Pelan</option>
            <option value="/music/langkah-robot.mp3" data-duration="53.3">Langkah Robot</option>
          </select>
        </label>
        <label class="music-volume">
          <span><%- icon('volume-2', 16) %> Volume</span>
          <input type="range" min="0" max="100" value="35" data-music-volume>
        </label>
      </div>
      <p class="music-message" role="status" data-music-message></p>
    </div>
  </section>
</details>
