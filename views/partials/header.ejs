<% const navigation = [
  { page: 'catalog', href: '/#katalog', icon: 'layout-grid', label: 'Katalog' },
  { page: 'kits', href: '/kit', icon: 'package-check', label: 'Kit Proyek' },
  { page: 'loans', href: '/peminjaman', icon: 'clipboard-list', label: 'Pinjaman' },
  { page: 'guide', href: '/panduan', icon: 'book-open', label: 'Panduan' },
]; %>
<header class="site-header" data-site-header <%= catalogOnly ? 'data-catalog-only' : '' %>>
  <div class="site-header-inner shell">
    <%- include('brand', { headerBrand: true }) %>
    <nav class="site-nav" aria-label="Navigasi utama">
      <% for (const item of navigation) { %>
        <% if (catalogOnly && item.page === 'loans') continue; %>
        <a class="dock-control" href="<%= item.href %>" <%= page === item.page ? 'aria-current=page' : '' %>>
          <%- icon(item.icon, 17) %><span class="nav-label"><%= item.label %></span>
          <span class="dock-tooltip" aria-hidden="true"><%= item.label %></span>
        </a>
      <% } %>
    </nav>
    <div class="header-account">
      <% if (catalogOnly) { %>
        <span class="badge badge-blue header-preview dock-control">
          <%- icon('eye', 16) %><span class="nav-label">Pratinjau katalog</span>
          <span class="dock-tooltip" aria-hidden="true">Pratinjau katalog</span>
        </span>
      <% } else if (!user) { %>
        <a href="/masuk" class="button button-small header-login dock-control">
          <%- icon('log-in', 17) %><span class="nav-label">Masuk</span>
          <span class="dock-tooltip" aria-hidden="true">Masuk</span>
        </a>
      <% } else { %>
        <details class="account-menu">
          <summary class="dock-control">
            <span class="avatar" aria-hidden="true"><%= initials(user.name) %></span>
            <span class="sr-only">Menu akun</span>
            <span class="account-name"><%= user.name %></span>
            <%- icon('chevron-down', 15) %>
            <span class="dock-tooltip" aria-hidden="true">Menu akun</span>
          </summary>
          <div class="account-popover">
            <div class="account-identity">
              <strong><%= user.name %></strong>
              <small><%= user.role === 'admin' ? 'Pengurus' : 'Anggota' %></small>
            </div>
            <% if (user.role === 'admin') { %>
              <a href="/admin" <%= page === 'admin' ? 'aria-current=page' : '' %>><%- icon('layout-dashboard', 17) %> Panel Pengurus</a>
            <% } else { %>
              <a href="/peminjaman" <%= page === 'loans' ? 'aria-current=page' : '' %>><%- icon('layout-dashboard', 17) %> Dashboard Anggota</a>
            <% } %>
            <form action="/keluar" method="post">
              <%- include('csrf') %>
              <button type="submit"><%- icon('log-out', 17) %> Keluar</button>
            </form>
          </div>
        </details>
      <% } %>
    </div>
  </div>
</header>
