<header class="site-header" data-site-header>
  <div class="site-header-inner shell">
    <%- include('brand') %>
    <nav class="site-nav" aria-label="Navigasi utama">
      <a href="/#katalog" <%= page === 'catalog' ? 'aria-current=page' : '' %>>
        <%- icon('layout-grid', 17) %><span class="nav-label">Katalog</span>
      </a>
      <% if (!catalogOnly) { %>
        <a href="/peminjaman" <%= page === 'loans' ? 'aria-current=page' : '' %>>
          <%- icon('clipboard-list', 17) %><span class="nav-label nav-label-long">Peminjaman Saya</span><span class="nav-label-short" aria-hidden="true">Pinjaman</span>
        </a>
      <% } %>
      <a href="/panduan" <%= page === 'guide' ? 'aria-current=page' : '' %>>
        <%- icon('book-open', 17) %><span class="nav-label">Panduan</span>
      </a>
    </nav>
    <div class="header-account">
      <% if (catalogOnly) { %>
        <span class="badge badge-blue header-preview"><%- icon('eye', 16) %><span>Pratinjau katalog</span></span>
      <% } else if (!user) { %>
        <a href="/masuk" class="button button-small header-login"><%- icon('log-in', 17) %><span>Masuk</span></a>
      <% } else { %>
        <details class="account-menu">
          <summary>
            <span class="avatar" aria-hidden="true"><%= initials(user.name) %></span>
            <span class="sr-only">Menu akun</span>
            <span class="account-name"><%= user.name %></span>
            <%- icon('chevron-down', 15) %>
          </summary>
          <div class="account-popover">
            <div class="account-identity">
              <strong><%= user.name %></strong>
              <small><%= user.role === 'admin' ? 'Pengurus' : 'Anggota' %></small>
            </div>
            <% if (user.role === 'admin') { %>
              <a href="/admin" <%= page === 'admin' ? 'aria-current=page' : '' %>><%- icon('layout-dashboard', 17) %> Panel Pengurus</a>
            <% } %>
            <form action="/keluar" method="post">
              <%- include('csrf') %>
              <button type="submit"><%- icon('log-out', 17) %> Keluar</button>
            </form>
          </div>
        </details>
      <% } %>
    </div>
  </div>
</header>
