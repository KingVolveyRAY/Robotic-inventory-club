<%- include('partials/head', { title: 'Rencana Kegiatan' }) %>
<%- include('partials/header') %>
<main id="konten" class="shell inner-main">
  <div class="page-heading">
    <div>
      <h1 data-word-reveal>Rencana kegiatan</h1>
      <p>Publikasikan agenda klub dan siapkan kebutuhan alat per tim.</p>
    </div>
    <a class="button button-secondary" href="/agenda"><%- icon('calendar-days', 18) %> Lihat agenda anggota</a>
  </div>
  <%- include('partials/admin-nav', { current: 'events' }) %>
  <%- include('partials/feedback') %>
  <div class="dashboard-columns event-columns">
    <section class="panel dashboard-panel">
      <div class="section-heading"><h2>Agenda tersimpan</h2><%- icon('calendar-days', 22) %></div>
      <% if (!events.length) { %>
        <p class="muted-copy">Tambahkan latihan, lomba, atau pengumuman pertama.</p>
      <% } else { %>
        <ul class="dashboard-links">
          <% for (const event of events) { %>
            <% const visibility = eventVisibility(event, today); %>
            <li><a href="/admin/kegiatan/<%= event.id %>">
              <span><strong><%= event.name %></strong><small><%= eventKinds[event.kind].label %> · <time datetime="<%= event.event_date %>"><%= formatDate(event.event_date) %></time><%= event.repeat_until ? ' · Mingguan' : '' %></small></span>
              <span class="badge badge-<%= visibility.tone %>"><%= visibility.label %></span>
            </a></li>
          <% } %>
        </ul>
      <% } %>
    </section>
    <section class="panel dashboard-panel">
      <div class="section-heading"><h2>Tambah agenda</h2></div>
      <form class="form-stack" method="post" action="/admin/kegiatan" data-busy-label="Membuat…">
        <%- include('partials/csrf') %>
        <%- include('partials/event-fields', { values }) %>
        <button type="submit" class="button button-primary"><%- icon('plus', 18) %> Simpan agenda</button>
      </form>
    </section>
  </div>
</main>
<%- include('partials/footer') %>
