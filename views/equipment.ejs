<%- include('partials/head', { title: item.name }) %>
<%- include('partials/header') %>
<main id="konten" class="shell inner-main">
  <a class="back-link" href="/#katalog"><%- icon('arrow-left', 17) %> Kembali ke katalog</a>
  <div class="detail-grid">
    <article class="panel equipment-detail">
      <div class="detail-media">
        <%- include('partials/equipment-image', { item, eager: true }) %>
        <%- include('partials/stock', { item }) %>
      </div>
      <div class="equipment-detail-copy">
        <span class="card-category"><%= categoryById[item.category].name %></span>
        <h1 data-word-reveal><%= item.name %></h1>
        <p><%= item.description %></p>
        <dl class="detail-stock">
          <div><dt>Tersedia</dt><dd><%= item.available %> unit</dd></div>
          <div><dt>Total stok</dt><dd><%= item.total %> unit</dd></div>
        </dl>
      </div>
    </article>

    <section class="panel detail-form">
      <span class="page-icon"><%- icon('clipboard-list', 24) %></span>
      <h2 data-word-reveal>Ajukan peminjaman</h2>
      <%- include('partials/feedback') %>
      <% if (catalogOnly) { %>
        <p class="page-description">Katalog ini berisi inventaris contoh. Pengajuan online memerlukan koneksi database klub.</p>
        <a class="button button-secondary" href="/panduan">Baca panduan <%- icon('arrow-right', 16) %></a>
      <% } else if (item.available < 1) { %>
        <p class="page-description">Seluruh unit sedang dipesan, dipinjam, atau stok alat ini sedang kosong.</p>
        <a class="button button-secondary" href="/#katalog">Lihat alat lain <%- icon('arrow-right', 16) %></a>
      <% } else if (!user) { %>
        <p class="page-description">Masuk atau buat akun anggota untuk memilih jumlah unit dan mengajukan tanggal pinjam.</p>
        <a class="button button-primary button-wide" href="/masuk?lanjut=<%= encodeURIComponent('/alat/' + item.id) %>">Masuk untuk meminjam <%- icon('arrow-right', 17) %></a>
      <% } else { %>
        <p class="page-description">Pilih jadwal dan jumlah alat. Pengurus akan meninjau pengajuanmu.</p>
        <form class="form-stack" action="/alat/<%= item.id %>/pinjam" method="post" data-loan-days="<%= maxLoanDays %>" data-busy-label="Mengirim pengajuan…">
          <%- include('partials/loan-form-fields', { quantityLabel: 'Jumlah unit', available: item.available }) %>
        </form>
      <% } %>
    </section>
  </div>
</main>
<%- include('partials/footer') %>
