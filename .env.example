# Akun pengurus awal untuk npm start. Isi kedua nilai sebelum memakai inventaris klub.
ROBOLAB_ADMIN_EMAIL=
ROBOLAB_ADMIN_PASSWORD=
# Atur 1 saat mengganti kata sandi akun lama. Naikkan angka untuk penggantian berikutnya.
# ROBOLAB_ADMIN_PASSWORD_REVISION=1

# Alamat server dan lokasi penyimpanan (folder data harus persisten).
# ROBOLAB_HOST=127.0.0.1
# PORT=3000
# ROBOLAB_DATABASE_PATH=.data/robolab.sqlite

# Aktifkan untuk situs yang diakses melalui HTTPS.
# ROBOLAB_SECURE_COOKIES=1

# Jika di belakang reverse proxy, isi jumlah hop tepercaya yang sebenarnya.
# ROBOLAB_PROXY_HOPS=1

# Penyimpanan PostgreSQL untuk Vercel atau npm start, opsional untuk pemakaian lokal.
# DATABASE_URL=
# ROBOLAB_SAMPLE_INVENTORY=1
